{
  "name": "freetoolshed",
  "version": "1.0.0",
  "description": "Utility Hub: A collection of free and useful tools for everyone!",
  "author": "João Costa <joao.coutinho08@gmail.com>",
  "license": "MIT",
  "homepage": "https://freetoolshed.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BleckWolf25/FreeToolshed.git"
  },
  "bugs": {
    "url": "https://github.com/BleckWolf25/FreeToolshed/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=9.0.0"
  },
  "onlyBuiltDependencies": [
    "core-js",
    "exifreader"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit",
    "validate": "pnpm lint && pnpm format && pnpm test && pnpm test:e2e && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "cron-parser": "^5.6.1",
    "cronstrue": "^3.24.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "diff-match-patch": "^1.0.5",
    "exifreader": "^4.41.3",
    "figlet": "^1.11.4",
    "js-yaml": "^5.2.3",
    "marked": "^18.0.7",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/crypto-js": "^4.2.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-corsa": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
